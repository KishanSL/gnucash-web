# PostgreSQL Configuration
POSTGRES_USER=gnucash
POSTGRES_PASSWORD=gnucash_secret
POSTGRES_DB=gnucash
POSTGRES_PORT=5432

# Ports
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8081
BACKEND_PORT=8082

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret
# Dedicated admin API key for CLI management scripts (falls back to JWT_SECRET if unset/empty)
ADMIN_API_KEY=
ALLOW_SIGNUP=false
INITIAL_ADMIN_PASSWORD=

# Data & Seed Directory
GNUCASH_SEED_DIR=/app/data
